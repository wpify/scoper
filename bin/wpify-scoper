#!/usr/bin/env php
<?php

use Composer\Factory;
use Composer\IO\ConsoleIO;
use Composer\Script\Event;
use Composer\Util\Platform;
use Symfony\Component\Console\Helper\HelperSet;
use Symfony\Component\Console\Input\ArgvInput;
use Wpify\Scoper\Plugin;

// $_composer_autoload_path is set by Composer's generated bin proxy (composer-runtime-api ^2.2).
// The fallbacks cover a checkout of this repository and a direct call that bypasses the proxy;
// the old `__DIR__ . '/../../..'` fatalled for both, and for symlinked path repositories.
$autoload = $GLOBALS['_composer_autoload_path'] ?? null;

if ( null === $autoload ) {
	foreach ( array(
		__DIR__ . '/../vendor/autoload.php',
		__DIR__ . '/../../../autoload.php',
	) as $candidate ) {
		if ( file_exists( $candidate ) ) {
			$autoload = $candidate;
			break;
		}
	}
}

if ( null === $autoload ) {
	fwrite( STDERR, 'wpify-scoper: could not locate the Composer autoloader.' . PHP_EOL );
	exit( 1 );
}

require_once $autoload;

$command = match ( $argv[1] ?? null ) {
	'install' => Plugin::SCOPER_INSTALL_CMD,
	'update'  => Plugin::SCOPER_UPDATE_CMD,
	default   => null,
};

if ( null === $command ) {
	fwrite( STDERR, 'Usage: wpify-scoper [command]' . PHP_EOL );
	fwrite( STDERR, '  commands:' . PHP_EOL );
	fwrite( STDERR, '    update' . PHP_EOL );
	fwrite( STDERR, '    install' . PHP_EOL . PHP_EOL );
	exit( 1 );
}

fwrite(
	STDERR,
	'wpify-scoper: this binary is deprecated, use "composer wpify-scoper ' . $argv[1] . '" instead.' . PHP_EOL
);

$input = new ArgvInput();
$input->setInteractive( Platform::isTty() );

$io = new ConsoleIO( $input, Factory::createOutput(), new HelperSet() );

try {
	$composer = ( new Factory() )->createComposer( $io );
	$plugin   = new Plugin();

	$plugin->activate( $composer, $io );
	$plugin->execute( new Event( $command, $composer, $io ) );
} catch ( Throwable $exception ) {
	$io->writeError( '<error>' . $exception->getMessage() . '</error>' );

	exit( 1 );
}
